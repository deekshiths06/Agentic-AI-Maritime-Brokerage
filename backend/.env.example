# ============================================================
# MARITIME AI - BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to backend/.env and adjust values as needed.
# Never commit the real backend/.env file.
# ============================================================

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/

# Database name
MONGO_DATABASE=maritime_brokerage

# ------------------------------------------------------------------
# Admin account (seeded automatically by the backend on startup).
# Values below are development/demo defaults. Do NOT use them in a
# public deployment. The admin password is never shown in the UI.
# ------------------------------------------------------------------
ADMIN_EMAIL=admin@maritime.ai
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Administrator

# Secret key used to sign login tokens.
JWT_SECRET=maritime-ai-dev-secret-key-2024

# ------------------------------------------------------------------
# Live AIS vessel tracking (Maritime Route Map).
# Provider: AISHub - https://www.aishub.net/api
# Required: a member username issued by AISHub after joining the
# AIS data-sharing network. The username is used as the API key.
#
# Get an account at https://www.aishub.net (AIS Dispatcher /
# receiver contribution is required by AISHub) and paste the
# username below. Never commit the real value.
# ------------------------------------------------------------------
AIS_API_KEY=

# AIS provider endpoint (defaults to AISHub). Override only if
# you host a compatible provider.
# AIS_API_URL=https://data.aishub.net/ws.php

# How long fetched vessel data stays cached in the backend
# before the provider is called again (seconds). Must stay well
# above the provider's once-per-minute limit.
# AIS_CACHE_TTL_SECONDS=180

# Maximum number of vessels returned to the map per snapshot.
# AIS_MAX_VESSELS=400

# Default request area as "latmin,lonmin,latmax,lonmax".
# Defaults to the whole world; tighten it to a region (e.g. the
# Indian Ocean) to keep payloads small.
# AIS_DEFAULT_BOUNDS=-90,-180,90,180