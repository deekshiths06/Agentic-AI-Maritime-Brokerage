# ============================================================
# MARITIME AI - BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to backend/.env and fill in the real values.
# Never commit the real backend/.env file.
#
# SECURITY: this template contains PLACEHOLDERS ONLY. The
# source code has no built-in default secret, so every secret
# below must be set before the backend runs. Copy a real
# deployment's credentials into your untracked backend/.env.
# ============================================================

# Application mode. Any value other than development/dev/local/
# test is treated as production-strict: the backend then refuses
# to start if JWT_SECRET or the admin credentials are missing.
APP_ENVIRONMENT=development

# MongoDB connection string.
# This is a local address, not a secret. A hosted database will
# supply its own connection string, which should be kept only in
# your untracked backend/.env.
MONGO_URI=mongodb://127.0.0.1:27017/

# Database name
MONGO_DATABASE=maritime_brokerage

# ------------------------------------------------------------------
# Admin account (seeded automatically by the backend on startup).
# Both ADMIN_EMAIL and ADMIN_PASSWORD must be set by you.
# When they are absent the backend starts in development but seeds
# NO admin account, so there is no default password to discover.
# In production mode, missing values stop the backend from starting.
# Generate a password, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# ------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ------------------------------------------------------------------
# Secret key used to sign login tokens.
# REQUIRED. Must be a long random value.
# If it is not set, development generates a random key for that
# single process (sessions end on restart) and production refuses
# to start. Anyone who knows this value can forge a valid token.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ------------------------------------------------------------------
JWT_SECRET=

# ------------------------------------------------------------------
# Live AIS vessel tracking (Maritime Route Map).
# Provider: AISHub - https://www.aishub.net/api
# Required: a member username issued by AISHub after joining the
# AIS data-sharing network. The username is used as the API key.
#
# Get an account at https://www.aishub.net (AIS Dispatcher /
# receiver contribution is required by AISHub) and paste the
# username below. Never commit the real value.
# ------------------------------------------------------------------
AIS_API_KEY=

# AIS provider endpoint (defaults to AISHub). Override only if
# you host a compatible provider.
# AIS_API_URL=https://data.aishub.net/ws.php

# How long fetched vessel data stays cached in the backend
# before the provider is called again (seconds). Must stay well
# above the provider's once-per-minute limit.
# AIS_CACHE_TTL_SECONDS=180

# Maximum number of vessels returned to the map per snapshot.
# AIS_MAX_VESSELS=400

# Default request area as "latmin,lonmin,latmax,lonmax".
# Defaults to the whole world; tighten it to a region (e.g. the
# Indian Ocean) to keep payloads small.
# AIS_DEFAULT_BOUNDS=-90,-180,90,180

# ------------------------------------------------------------------
# CUSTOMS ADVISORY (GEMINI)
# ------------------------------------------------------------------
# Gemini is the natural language EXPLANATION layer of the Customs
# module and nothing else.
#
#   Customs Dataset -> Customs Agent -> deterministic status,
#   compliance % and missing documents -> Gemini -> readable
#   advisory sentence
#
# The customs_status, the compliance percentage and the missing
# document list are ALWAYS calculated by the Customs Agent from
# backend/app/customs.csv. Gemini only explains those results and
# can never add, remove or change a customs requirement.
#
# Get a key at https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty to run the module without Gemini.
# The deterministic Customs Agent keeps working and the UI shows
# the deterministic advisory instead. Nothing breaks.
# Never commit the real value.
# ------------------------------------------------------------------
GEMINI_API_KEY=

# Gemini model used for the advisory sentence. The default is
# gemini-3.6-flash. gemini-2.5-flash is retired and now answers
# generateContent with HTTP 404 for new keys. Change it only if
# the default model is unavailable for your key.
# GEMINI_MODEL=gemini-3.6-flash

# How long the backend waits for Gemini before it falls back to
# the deterministic advisory (seconds).
# GEMINI_TIMEOUT_SECONDS=8

# Set to false to switch the Gemini explanation layer off while
# keeping the Customs Agent fully active.
# GEMINI_CUSTOMS_ENABLED=true